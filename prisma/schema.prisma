datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  email              String    @unique
  googleId           String?   @unique
  firebaseUid        String?   @unique
  passwordHash       String?
  avatar             String    @default("cyber_ninja")
  xp                 Int       @default(0)
  level              Int       @default(1)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  totalSolved        Int       @default(0)
  streakShields      Int       @default(1)
  leetcodeUsername   String?
  leetcodeConnected  Boolean   @default(false)
  role               String    @default("USER") // USER | ADMIN
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  groupMemberships   GroupMember[]
  submissions        Submission[]
  dailyChallenges    DailyChallenge[]
  xpTransactions     XpTransaction[]
  problemStatuses    UserProblemStatus[]
  userAchievements   UserAchievement[]
  notifications      Notification[]
  sentChallenges     FriendChallenge[]   @relation("ChallengerRelation")
  receivedChallenges FriendChallenge[]   @relation("ChallengedRelation")
  streakRecords      StreakRecord[]
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  avatar      String        @default("neon_shield")
  inviteCode  String        @unique
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members      GroupMember[]
  groupSeasons GroupSeason[]
}

model GroupMember {
  id           String   @id @default(cuid())
  userId       String
  groupId      String
  role         String   @default("MEMBER") // LEADER | MEMBER
  joinedAt     DateTime @default(now())
  previousRank Int?
  currentRank  Int?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model Problem {
  id            Int      @id
  title         String
  topic         String
  category      String
  difficulty    String   // Easy | Medium | Hard
  orderInSheet  Int      @unique
  leetcodeUrl   String?
  articleUrl    String?
  youtubeUrl    String?
  description   String
  hint          String?
  constraints   String?
  examplesJson  String?  // JSON string of examples

  submissions     Submission[]
  userStatuses    UserProblemStatus[]
  challenges      FriendChallenge[]
}

model DailyChallenge {
  id          String    @id @default(cuid())
  userId      String
  date        String    // YYYY-MM-DD
  problem1Id  Int
  problem2Id  Int
  problem3Id  Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Submission {
  id                   String   @id @default(cuid())
  userId               String
  problemId            Int
  code                 String?
  language             String?  // cpp | java | python | javascript
  timeComplexity       String?
  spaceComplexity      String?
  approach             String?
  status               String   // SOLVED | OPTIMAL
  xpEarned             Int      @default(0)
  bonusXp              Int      @default(0)
  source               String   @default("LEETCODE") // LEETCODE | DIRECT_VERIFIED
  leetcodeSubmissionId String?
  createdAt            DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
}

model UserProblemStatus {
  id                  String    @id @default(cuid())
  userId              String
  problemId           Int
  status              String    @default("UNSOLVED") // UNSOLVED | SOLVED | OPTIMAL
  attemptsCount       Int       @default(0)
  firstSolvedAt       DateTime?
  lastAttemptedAt     DateTime  @default(now())
  submissionReference String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, status])
}

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String   // BASE_SOLVE | OPTIMAL_BONUS | DAILY_3_OF_3 | STREAK_MILESTONE | ACHIEVEMENT | CHALLENGE_WIN
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StreakRecord {
  id          String   @id @default(cuid())
  userId      String
  date        String   // YYYY-MM-DD
  solvedCount Int      @default(0)
  shieldUsed  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Achievement {
  id          String   @id
  name        String
  description String
  icon        String   // emoji or icon code
  xpReward    Int      @default(100)
  category    String   // STREAK | PROBLEMS | LEADERBOARD | SEASONS
  tier        String   // BRONZE | SILVER | GOLD | PLATINUM | DIAMOND

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model Season {
  id          String   @id @default(cuid())
  name        String
  seasonNumber Int
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  groupSeasons GroupSeason[]
}

model GroupSeason {
  id        String   @id @default(cuid())
  groupId   String
  seasonId  String
  rank1UserId String?
  rank2UserId String?
  rank3UserId String?
  createdAt DateTime @default(now())

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([groupId, seasonId])
}

model FriendChallenge {
  id           String    @id @default(cuid())
  challengerId String
  challengedId String
  problemId    Int
  xpStake      Int       @default(150)
  status       String    @default("PENDING") // PENDING | ACCEPTED | COMPLETED | EXPIRED
  winnerId     String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  challenger User    @relation("ChallengerRelation", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged User    @relation("ChallengedRelation", fields: [challengedId], references: [id], onDelete: Cascade)
  problem    Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([challengerId, challengedId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // OVERTAKEN | CHALLENGE_RECEIVED | CHALLENGE_WON | DAILY_RESET | STREAK_WARNING
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
